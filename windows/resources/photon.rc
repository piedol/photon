#include <winres.h>

1 ICON "photon.ico"
1 RT_MANIFEST "photon.manifest"

// Keep these versions in step with windows/Cargo.toml.
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,2,2,0
PRODUCTVERSION 0,2,2,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "piedol"
      VALUE "FileDescription", "Photon"
      VALUE "FileVersion", "0.2.2"
      VALUE "InternalName", "Photon"
      VALUE "LegalCopyright", "Copyright (c) 2026 piedol. GPL-3.0-or-later"
      VALUE "OriginalFilename", "Photon.exe"
      VALUE "ProductName", "Photon"
      VALUE "ProductVersion", "0.2.2"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
